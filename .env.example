# Copied to .env by CI (and by you, locally) before a build.
#
# IMPORTANT: never leave a key here with an empty value, e.g. `SENTRY_DSN=`.
# The secrets Gradle plugin turns every key in this file into a BuildConfig field, and a blank
# value emits `public static final String SENTRY_DSN = ;` — which is not valid Java and fails
# :app:compileDebugJavaWithJavac. Optional settings stay commented out instead; app/build.gradle.kts
# already declares a safe empty default for each, so an absent key builds fine and simply leaves
# that feature switched off.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SENTRY_DSN: Sentry error-reporting endpoint.
# Obtain from your Sentry project: Settings > Client Keys (DSN).
# Leave commented out in development; the crash-reporter falls back to a no-op.
# CI appends a real value from secrets.SENTRY_DSN when one is configured.
#SENTRY_DSN=https://your-key@sentry.io/project-id

# Optional cloud project backup (offline-first: optional).
# SUPABASE_URL: Your Supabase project URL (https://<project-ref>.supabase.co)
#SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_ANON_KEY: Supabase anon/public API key for PostgREST calls.
# Use the public anon/publishable key only.
# Never put a service_role or secret key in the Android client.
# Find in: Supabase Dashboard > Settings > API > anon public
#SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: there is deliberately no SUPABASE_ACCESS_TOKEN here.
# A user session token is a per-user credential and is never read at build time. Compiling one
# into the app would ship a single shared identity to every install, unrevocable and readable by
# anyone who unzips the APK. The token is provided at runtime by SupabaseSessionProvider once a
# real sign-in flow exists; until then MA¢SENSE runs local-only and cloud sync stays disabled.
