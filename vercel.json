{
  "version": 2,
  "public": true,
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-MacSense-Release-Gate", "value": "repo-backed-vercel" }
      ]
    }
  ]
}
